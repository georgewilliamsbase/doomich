# Модельный слой (compose.models.yml). Конфигурация Б: 2x RTX 4090, LLM на GPU 0, остальное на GPU 1.
REGISTRY=ghcr.io/georgewilliamsbase
TAG=1.0.0
MODELS_DIR=/srv/doomich/models
VLLM_TAG=v0.11.0
LLM_DIR=qwen3.6-35b-a3b-awq
LLM_MODEL=qwen3.6-35b-a3b
LLM_GPU=0
LLM_GPU_UTIL=0.90
LLM_MAX_LEN=32768
LLM_TOOL_PARSER=hermes
EMBED_DIR=qwen3-embedding-0.6b
EMBED_MODEL=qwen3-embedding-0.6b
RERANK_DIR=qwen3-reranker-0.6b
RERANK_MODEL=qwen3-reranker-0.6b
AUX_GPU=1
EMBED_GPU_UTIL=0.08
RERANK_GPU_UTIL=0.08
ASR_RU_BACKEND=sherpa
ASR_EN_BACKEND=faster_whisper
TTS_BACKEND=openai_speech
TTS_MODEL=qwen3-tts
