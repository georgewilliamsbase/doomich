server {
  listen 443 ssl;
  http2 on;
  server_name ${PROD_HOST};
  set $api_upstream http://api-prod:8000;
  include /etc/nginx/conf.d/doomich-locations.inc;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${STAGE_HOST};
  set $api_upstream http://api-stage:8000;
  include /etc/nginx/conf.d/doomich-locations.inc;
}
