ssl_certificate     /etc/letsencrypt/live/${PROD_HOST}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${PROD_HOST}/privkey.pem;
ssl_protocols TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_tickets off;
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy no-referrer always;
server_tokens off;
resolver 127.0.0.11 valid=30s;
client_max_body_size 25m;
limit_conn conn 50;

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_http_version 1.1;

location = /metrics { return 404; }
location /docs { return 404; }

location /v1/auth/ {
  limit_req zone=auth burst=20 nodelay;
  proxy_pass $api_upstream;
}

# Потоковые ответы чата (SSE): без буферизации
location ~ ^/v1/chats/.+/(messages|retry)$ {
  limit_req zone=api burst=40 nodelay;
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 300s;
  proxy_pass $api_upstream;
}

# Голосовой канал (WebSocket)
location /v1/voice {
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 600s;
  proxy_pass $api_upstream;
}

# Лекции загружаются частями до 32 МБ
location /v1/lectures {
  client_max_body_size 40m;
  proxy_request_buffering off;
  proxy_read_timeout 300s;
  proxy_pass $api_upstream;
}

location /v1/ {
  limit_req zone=api burst=40 nodelay;
  proxy_pass $api_upstream;
}

# Админ-панель и админ-API только из сети VPN
location /admin/ {
  allow ${VPN_SUBNET};
  deny all;
  root /srv;
  try_files $uri $uri/ /admin/index.html;
}
location /admin/v1/ {
  allow ${VPN_SUBNET};
  deny all;
  proxy_pass $api_upstream;
}
location /grafana/ {
  allow ${VPN_SUBNET};
  deny all;
  set $grafana http://grafana:3000;
  proxy_set_header Host $host;
  proxy_pass $grafana;
}

location /health { proxy_pass $api_upstream; }
location / { return 404; }
