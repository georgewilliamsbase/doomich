# Стек приложения prod (compose.app.yml). Секреты в ./secrets, не здесь.
STACK=prod
DOOMICH_ENV=prod
REGISTRY=ghcr.io/georgewilliamsbase
TAG=1.0.0
PUBLIC_BASE_URL=https://api.doomich.example
ADMIN_ORIGIN=https://api.doomich.example
LLM_MODEL=qwen3.6-35b-a3b
EMBED_MODEL=qwen3-embedding-0.6b
RERANK_MODEL=qwen3-reranker-0.6b
API_WORKERS=2
WORKER_CONCURRENCY=4
PG_SHARED_BUFFERS=2GB
PG_CACHE=6GB
SENTRY_DSN=
